{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "enabledManagers": [
    "gradle",
    "gradle-wrapper",
    "github-actions"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Etc/UTC",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "One PR for all AndroidX libraries and the Compose BOM.",
      "matchPackageNames": [
        "androidx.**"
      ],
      "groupName": "AndroidX"
    },
    {
      "description": "Kotlin, its Gradle plugins and the Compose compiler plugin (everything on the kotlin version ref) move together. Does not match org.jetbrains.kotlinx.",
      "matchPackageNames": [
        "org.jetbrains.kotlin:**",
        "org.jetbrains.kotlin.**"
      ],
      "groupName": "Kotlin"
    },
    {
      "description": "OkHttp artifacts share one version.",
      "matchPackageNames": [
        "com.squareup.okhttp3:**"
      ],
      "groupName": "OkHttp"
    }
  ]
}
