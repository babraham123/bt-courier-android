<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Bouncy Castle's bcpkix (pulled in by sshj) ships an accept-all trust manager in its EST
         client helpers (JcaJceUtils). Nothing here calls them: sshj verifies SSH host keys, not
         X.509 chains. The check stays on for the app's own code. -->
    <issue id="TrustAllX509TrustManager">
        <ignore path="**/bcpkix-*.jar" />
    </issue>
    <!-- Whether the target SDK is "old" depends on which platforms the running machine has
         installed, so the check passes locally and fails on a runner with a newer SDK. The
         target is raised deliberately, together with AGP and compileSdk, not by lint. -->
    <issue id="OldTargetApi" severity="ignore" />
</lint>
