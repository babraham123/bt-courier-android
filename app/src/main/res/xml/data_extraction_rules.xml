<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred: the upload secret is bound to this phone's keystore, and
  the store's cursor and pending batches restored on another phone would re-upload or skip data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
